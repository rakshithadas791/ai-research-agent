# Default provider: Groq's free tier (open-weight models, no credit card).
# Get a free key at https://console.groq.com
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional: only needed if you deliberately switch LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Set to true for offline/classroom demo runs with no API key at all.
# The agent still executes the same plan -> tool -> observe -> synthesize workflow.
MOCK_LLM=false
